generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model event_organizer {
  EO_ID                    Int                        @id @default(autoincrement())
  EO_name                  String                     @db.VarChar(100)
  EO_Description           String                     @db.Text
  EO_Address               String                     @db.VarChar(255)
  EO_Price                 Decimal?                   @db.Decimal(12, 2)
  EO_Number                String                     @db.VarChar(20)
  EO_Rating                Decimal?                   @db.Decimal(2, 1)
    EO_Image               String?                    @db.VarChar(255)
  Created_at               DateTime                   @default(now()) @db.Timestamp(0)
  event_organizer_services event_organizer_services[]
  rating                   rating[]
  transaction              transaction[]
}

model event_organizer_services {
  EO_services_ID     Int              @id @default(autoincrement())
  Event_Organizer_ID Int
  Main_Services_ID   Int
  Additional_Feature String?          @db.VarChar(255)
  event_organizer    event_organizer @relation(fields: [Event_Organizer_ID], references: [EO_ID], onDelete: Restrict, onUpdate: Restrict, map: "fk_eo_id")
  services           services        @relation(fields: [Main_Services_ID], references: [Service_ID], onDelete: Restrict, onUpdate: Restrict, map: "fk_service_id")

  @@index([Event_Organizer_ID], map: "fk_eo_id")
  @@index([Main_Services_ID], map: "fk_service_id")
}

model payments {
  Payments_ID    Int                      @id
  Transaction_ID Int?
  Payment_Method payments_Payment_Method? @default(bank_transfer)
  Payment_Status payments_Payment_Status? @default(Pending)
  Amount         Decimal?                 @db.Decimal(12, 2)
  Payment_date   DateTime                 @default(now()) @db.Timestamp(0)
  transaction    transaction?             @relation(fields: [Transaction_ID], references: [Transaction_ID], onDelete: Restrict, onUpdate: Restrict, map: "fk_transaction_payment")

  @@index([Transaction_ID], map: "fk_transaction_payment")
}

model rating {
  Rating_ID          Int              @id @default(autoincrement())
  User_ID            Int?
  Event_Organizer_ID Int?
  Rating             Int
  Comment            String?          @db.Text
  Created_At         DateTime         @default(now()) @db.Timestamp(0)
  event_organizer    event_organizer? @relation(fields: [Event_Organizer_ID], references: [EO_ID], onDelete: Restrict, onUpdate: Restrict, map: "fk_eo_rating")
  users              users?           @relation(fields: [User_ID], references: [User_ID], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_rating")

  @@index([Event_Organizer_ID], map: "fk_eo_rating")
  @@index([User_ID], map: "fk_user_rating")
}

model services {
  Service_ID               Int                        @id @default(autoincrement())
  Service_name             String                     @unique(map: "Service_name") @db.VarChar(100)
  event_organizer_services event_organizer_services[]
}

model transaction {
  Transaction_ID     Int                             @id @default(autoincrement())
  Event_Date         DateTime                        @db.Date
  Event_Location     String                          @db.Text
  Total_price        Decimal?                        @db.Decimal(12, 2)
  Transaction_Status transaction_Transaction_Status? @default(Pending)
  Created_at         DateTime                        @default(now()) @db.Timestamp(0)
  User_ID            Int?
  Event_Organizer_ID Int?
  payments           payments[]
  event_organizer    event_organizer?                @relation(fields: [Event_Organizer_ID], references: [EO_ID], onDelete: Restrict, onUpdate: Restrict, map: "fk_eo_transaction")
  users              users?                          @relation(fields: [User_ID], references: [User_ID], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_transaction")

  @@index([Event_Organizer_ID], map: "fk_eo_transaction")
  @@index([User_ID], map: "fk_user_transaction")
}

model users {
  User_ID          Int           @id @default(autoincrement())
  Username         String        @db.VarChar(100)
  User_email       String        @unique(map: "User_email") @db.VarChar(100)
  User_password    String        @db.VarChar(255)
  User_PhoneNumber String        @db.VarChar(20)
  Created_at       DateTime      @default(now()) @db.Timestamp(0)
  Update_at        DateTime      @default(now()) @updatedAt @db.Timestamp(0)
  rating           rating[]
  transaction      transaction[]
}

enum payments_Payment_Method {
  bank_transfer
  e_wallet
  credit_card
  Cancelled
}

enum payments_Payment_Status {
  Pending
  Succeed
  Failed
}

enum transaction_Transaction_Status {
  Pending
  Processing
  Completed
  Cancelled
}
